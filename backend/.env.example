# Environment variables for Hamid Cloth House Backend
# Copy this file to .env and fill in the values

# MongoDB
MONGODB_URL=mongodb://localhost:27017
DB_NAME=hamid_cloth_house

# JWT
JWT_SECRET=change-this-to-a-random-secure-string
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# SMTP Email (for password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@hamidclothhouse.com
SMTP_USE_TLS=true

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# App
APP_NAME=Hamid Cloth House
DEBUG=true

# Render keep-alive interval (minutes)
RENDER_SLEEP_PING_INTERVAL=14
